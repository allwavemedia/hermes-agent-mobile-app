{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.invalid/schemas/remote-control/v1/event.schema.json",
  "title": "Hermes Remote Control v1 Ordered Session Event Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "prevSeq", "eventId", "occurredAt", "eventType", "data"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "prevSeq": {"type": "integer", "minimum": 0},
    "eventId": {"type": "string", "minLength": 8, "maxLength": 128},
    "occurredAt": {"type": "string", "format": "date-time"},
    "eventType": {
      "enum": [
        "message.started",
        "message.delta",
        "message.interim",
        "message.completed",
        "reasoning.started",
        "reasoning.delta",
        "reasoning.completed",
        "tool.started",
        "tool.progress",
        "tool.completed",
        "tool.failed",
        "tool.risk",
        "request.approval",
        "request.clarification",
        "request.terminalRead",
        "request.resolved",
        "request.expired",
        "session.status",
        "session.title",
        "session.usage",
        "session.context",
        "terminal.opened",
        "terminal.output",
        "terminal.closed",
        "attachment.accepted",
        "attachment.progress",
        "attachment.available",
        "attachment.failed",
        "attachment.expired",
        "subagent.started",
        "subagent.updated",
        "subagent.completed",
        "capabilities.changed",
        "session.remoteDisabled"
      ]
    },
    "causedByCommandId": {"type": "string", "minLength": 8, "maxLength": 128},
    "data": {"type": "object", "maxProperties": 128}
  }
}
